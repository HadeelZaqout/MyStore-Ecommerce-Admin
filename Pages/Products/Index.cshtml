@page
@using MyStore.Pages.Models
@using Microsoft.AspNetCore.Html
@model MyStore.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products - List";
}

@functions{
    public IHtmlContent SortIcon (string column, string currentSort)
    {
        if (currentSort == column)
            return new HtmlString("<span>▲</span>");

        if (currentSort == column + "_desc")
            return new HtmlString("<span>▼</span>");

        return new HtmlString("<span>⇵</span>");
    }
}

<div class="d-flex flex-column flex-column-fluid">
    <!-- Toolbar -->
    <div id="kt_app_toolbar" class="app-toolbar">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Products List
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted"><a href="/" class="text-muted text-hover-primary">Home</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">Products</li>
                </ul>
            </div>
            <form>
                <div class="row align-items-center pe-2">
                    <div class=" m-0 p-0 row  justify-content-end align-items-center">
                        <div class="col-auto d-inline-flex">
                            <h1 class="col-auto me-2 d-flex text-dark fw-bold fs-3 mt-4">Results Number</h1>
                            <select class=" form-select" onchange="this.form.submit()" asp-for="@Model.PageSize">
                                <option value="5">5</option>
                                <option value="10">10</option>
                                <option value="20">20</option>
                            </select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Content -->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="card">
                <!-- Card header -->
                <div class="card-header mt-3 border-0">
                    <div class="card-title">
                        <!-- Search form -->
                        <form method="get" class="d-flex align-items-center">
                            <div class=" d-flex align-items-center position-relative my-1">
                                <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-5">
                                    <span class="path1"></span><span class="path2"></span>
                                </i>
                                <input name="Search" type="text" class="form-control form-control-solid w-250px ps-12"
                                       placeholder="Search by product title"
                                       asp-for="@Model.Search" />
                                <select class="form-select ms-2 bg-light text-muted" asp-for="@Model.CategoryId" asp-items="Model.Categories">
                                    <option value="">All Categories</option>
                                </select>
                                <button type="submit" class="btn btn-light-primary mx-2">Search</button>
                            </div>
                            

                        </form>
                    </div>
                    <div class="card-toolbar">
                        <div class="d-flex justify-content-end align-items-center gap-3">
                            <span class="badge badge-light-primary fs-7 fw-semibold">
                                Total: @Model.Products.QueryCount Products
                            </span>
                            <!-- Add Product button -->
                            <a  asp-page="Create" class="btn btn-primary">
                                <i class="ki-duotone ki-plus fs-2"></i>Add Product
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="card-body mt-3 pt-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-row-dashed fs-6 gy-5 table-store">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                    <th>Image</th>
                                    <th>
                                        <a asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-PageSize="@Model.PageSize"
                                            asp-route-SortField="Name"
                                            asp-route-SortOrder="@(Model.SortOrder =="Name" ? "Name_desc" : "Name")"
                                            class=" text-gray-700 text-decoration-none">
                                            Name @SortIcon("Name", Model.SortOrder)  
                                        </a>
                                    </th>
                                    <th>Category</th>
                                    <th>
                                        <a   asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-PageSize="@Model.PageSize"
                                             asp-route-SortField="Price"
                                             asp-route-SortOrder="@(Model.SortOrder =="Price" ? "Price_desc" : "Price")"
                                             class=" text-gray-700 text-decoration-none">
                                            Price @SortIcon("Price", Model.SortOrder)
                                        </a>
                                    </th>
                                    <th class=" actions-col">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-700 fw-semibold">
                                @if (!Model.Products.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-10">No products found for the selected search/filter.</td>
                                    </tr>
                                }
                                @foreach (Product p in Model.Products)
                                {
                                    <tr>
                                        <td>
                                            <img src="@p.ImageUrl" width="52" class="img-thumbnail table-thumb" />
                                        </td>
                                        <td>@p.Name</td>
                                        <td>@p.Category?.Name</td>
                                        <td>@p.Price.ToString("C")</td>
                                        <td class=" actions-col">
                                            <div class="actions-group">
                                                <a asp-page="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-light-warning">Edit</a>
                                                <a asp-page="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-light-danger">Delete</a>
                                                <a asp-page="Images" asp-route-id="@p.ProductId" class="btn btn-sm btn-light-info">Images</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <hr/>
                    <div class="row">
                        <div class="col-sm-12  d-flex align-items-center justify-content-md-center ">
                            <div class="dataTables_paginate paging_simple_numbers" id="kt_subscriptions_table_paginate">
                                <ul class="pagination justify-content-center flex-wrap">
                                    @if (Model.Products.HasPreviousPage)
                                    {
                                        <li class="paginate_button page-item previous disabled" id="kt_subscriptions_table_previous">
                                            <a asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@(Model.Products.PageIndex - 1)" aria-controls="kt_subscriptions_table" data-dt-idx="0" tabindex="0" class="page-link">
                                                <i class="previous"></i>
                                            </a>
                                        </li>  
                                    }
                                    @for (int i = 1; i <= Model.Products.TotalPages; i++)
                                    {
                                        <li class="paginate_button page-item @(i == Model.Products.PageIndex ? "active" : "" )">
                                            <a asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@i" aria-controls="kt_subscriptions_table" data-dt-idx="1" tabindex="0" class="page-link">@i</a>
                                        </li>            
                                    }
                                    @if (Model.Products.HasNextPage)
                                    {
                                        <li class="paginate_button page-item next" id="kt_subscriptions_table_next">
                                            <a asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-PageSize="@Model.PageSize" asp-route-PageIndex="@(Model.Products.PageIndex + 1)" aria-controls="kt_subscriptions_table" data-dt-idx="3" tabindex="0" class="page-link">
                                                <i class="next"></i>
                                            </a>
                                        </li>            
                                    }
                                </ul>
                             </div>
                         </div>
                     </div>
               
                 </div>
            </div>
        </div>
    </div>
</div>
