@page
@model MyStore.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Categories - Delete";
}
<h2 class="text-danger mb-3"><i class="bi bi-trash3-fill text-danger"></i> Delete Category</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this product?
</div>

<div class="card mb-3" style="max-width: 500px;">
    <div class="card-body">
        <img src="@Model.Category.ImageUrl"
             class="img-fluid rounded mb-3" />

        <h5 class="card-title">@Model.Category.Name</h5>
    </div>
</div>

<form method="post">
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash3-fill"></i> Yes, Delete
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

