@page "{id}"
@model MyStore.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Categories - Edit";
}
<div class="card border-0 shadow-sm">
    <div class="card-body p-8">
        <h2 class="mb-6"><i class="bi bi-pen-fill text-success me-2"></i> Edit Category</h2>

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Category.CategoryId" />
            <input type="hidden" asp-for="Category.ImageUrl" />

            <div class="row g-6">
                <div class="col-md-6">
                    <div class="mb-4">
                        <label asp-for="Category.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Category.Name" class="form-control" />
                        <span asp-validation-for="Category.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Main Image</label>
                        <input type="file" asp-for="Category.Image" class="form-control" accept="@MyStore.Services.UploadImageService.accept" />
                        <span asp-validation-for="Category.Image" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Current Image</label>
                    <div>
                        <img src="@Model.Category.ImageUrl" class="img-thumbnail table-thumb-lg mb-2" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 mt-2">
                <button type="submit" class="btn btn-success px-5">
                    <i class="bi bi-floppy2-fill me-2"></i>
                    Save Changes
                </button>
                <a asp-page="Index" class="btn btn-secondary px-5">
                    <i class="bi bi-house-door-fill me-2"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <partial name="_validationscriptspartial" />
}


