@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="mb-1">@ViewData["Title"]</h3>
<p class="text-gray-600 mb-6">Update your basic profile information below.</p>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row g-6">
    <div class="col-lg-4 mb-6 mb-lg-0">
        <div class="card border border-gray-200 shadow-sm h-100 overflow-hidden">
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-9">
                <div class="symbol symbol-125px symbol-circle mb-5">
                    <img src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "/assets/media/avatars/300-1.jpg" : Model.AvatarUrl)" alt="User avatar" style="object-fit: cover;" />
                </div>
                <div class="fw-bold fs-3 text-gray-900 mb-4 text-break">@Model.Username</div>
                <div class="badge badge-light-primary px-4 py-3 fs-7">Upload an avatar to personalize your profile</div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border border-gray-200 shadow-sm">
            <div class="card-body p-8">
                <div class="d-flex justify-content-between align-items-center mb-6">
                    <h4 class="mb-0 fw-bold">Profile details</h4>
                    <span class="text-gray-500 fs-7">Keep your data up to date</span>
                </div>
                <form id="profile-form" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert"></div>
                    <div class="form-floating mb-4">
                        <input asp-for="Username" class="form-control bg-light" placeholder="Please choose your username." disabled />
                        <label asp-for="Username" class="form-label"></label>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Input.PhoneNumber" class="form-control bg-transparent" placeholder="Please enter your phone number." />
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Address" class="form-control bg-transparent" placeholder="Enter your address." />
                        <label asp-for="Input.Address" class="form-label"></label>
                        <span asp-validation-for="Input.Address" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Tel" class="form-control bg-transparent" placeholder="Enter your phone number." />
                        <label asp-for="Input.Tel" class="form-label"></label>
                        <span asp-validation-for="Input.Tel" class="text-danger"></span>
                    </div>
                    <div class="mb-6">
                        <label asp-for="Input.AvatarFile" class="form-label fw-semibold fs-6"></label>
                        <input asp-for="Input.AvatarFile" type="file" accept="@MyStore.Services.UploadImageService.accept" class="form-control form-control-solid" />
                        <span asp-validation-for="Input.AvatarFile" class="text-danger"></span>
                        <div class="form-text mt-2">Allowed formats: jpg, jpeg, png, tif, gif. Max size 1 MB.</div>
                    </div>
                    <button id="update-profile-button" type="submit" class="w-100 btn btn-primary">
                        <span class="indicator-label">Save changes</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
