@{
    Layout = "/Areas/Identity/Pages/Account/_AuthLayout.cshtml";
    ViewData["AuthContentWidth"] = "w-lg-1100px";
    ViewData["AuthSubtitle"] = "Manage profile, email, security settings, and personal data from one place.";
    ViewData["HideAuthAside"] = true;
}

<div class="card shadow-lg border-0">
    <div class="card-body p-8 p-lg-10">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-6">
            <div>
                <h1 class="mb-2">Manage your account</h1>
                <h2 class="fs-4 text-gray-600 mb-0">Change your account settings</h2>
            </div>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light-primary btn-sm mt-4 mt-md-0">Back to login</a>
        </div>
        <div class="row g-7">
            <div class="col-md-4 col-lg-3">
                <div class="border rounded p-3 bg-light-primary">
                    <partial name="_ManageNav" />
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="border rounded p-6">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
