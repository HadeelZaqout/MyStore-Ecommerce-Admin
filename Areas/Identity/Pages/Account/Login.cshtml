@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="form w-100 fv-plugins-bootstrap5 fv-plugins-framework" novalidate="novalidate" id="kt_sign_in_form">
    <div class="text-center mb-11">
        <h1 class="text-dark fw-bolder mb-3">Sign In</h1>
        <div class="text-gray-500 fw-semibold fs-6">Welcome back to MyStore</div>
        <div asp-validation-summary="ModelOnly" class="text-danger mt-3" role="alert"></div>
    </div>

    <div class="separator separator-content my-14">
        <span class="w-125px text-gray-500 fw-semibold fs-7">Use your email</span>
    </div>

    <div class="form-floating fv-row mb-8 fv-plugins-icon-container">
        <input type="email" asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Email" class="form-control bg-transparent" />
        <label asp-for="Input.Email" class="form-label">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-floating fv-row mb-3 fv-plugins-icon-container">
        <input asp-for="Input.Password" type="password" placeholder="Password" aria-required="true" autocomplete="current-password" class="form-control bg-transparent" />
        <label asp-for="Input.Password" class="form-label">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-8">
        <div class="form-check form-check-custom form-check-solid">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe" class="form-check-label ms-2">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
        </div>
        <a id="forgot-password" class="link-primary" asp-page="./ForgotPassword">Forgot password?</a>
    </div>

    <div class="d-grid mb-10">
        <button type="submit" id="login-submit" class="btn btn-primary">
            <span class="indicator-label">Log In</span>
        </button>
    </div>

    <div class="text-gray-500 text-center fw-semibold fs-6">
        Not a member yet?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-primary">Sign up</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
