@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_AuthLayout";
}

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form w-100">
    <div class="text-center mb-11">
        <h1 class="text-dark fw-bolder mb-3">Create Account</h1>
        <div class="text-gray-500 fw-semibold fs-6">Join MyStore in a few simple steps</div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-5" role="alert"></div>

    <div class="form-floating mb-4">
        <input asp-for="Input.Email" class="form-control bg-transparent" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.Address" class="form-control bg-transparent" aria-required="true" placeholder="Address" />
        <label asp-for="Input.Address">Address</label>
        <span asp-validation-for="Input.Address" class="text-danger"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.Tel" class="form-control bg-transparent" aria-required="true" placeholder="Phone Number" />
        <label asp-for="Input.Tel">Phone Number</label>
        <span asp-validation-for="Input.Tel" class="text-danger"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.Password" class="form-control bg-transparent" autocomplete="new-password" aria-required="true" placeholder="Password" />
        <label asp-for="Input.Password">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="form-floating mb-6">
        <input asp-for="Input.ConfirmPassword" class="form-control bg-transparent" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-grid mb-8">
        <button id="registerSubmit" type="submit" class="btn btn-primary">Register</button>
    </div>

    <div class="text-gray-500 text-center fw-semibold fs-6">
        Already have an account?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="link-primary">Sign in</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
